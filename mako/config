# Mako notification daemon config

# Appearance
font=Space Mono 11
width=350
height=100
margin=15
padding=10
border-size=2
border-radius=5
max-visible=5
max-history=20

# Colors
background-color=#090307cc
text-color=#D7BDEC
border-color=#8485D9

# Urgency levels
[urgency=low]
border-color=#724782

[urgency=normal]
border-color=#8485D9
progress-color=source #D18DBD

[urgency=critical]
border-color=#A44E88
text-color=#D7BDEC
progress-color=source #A44E88

# Actions
on-notify=none
on-button-left=dismiss
on-button-middle=none
on-button-right=dismiss
on-touch=dismiss

# Timeout
default-timeout=5000
ignore-timeout=1

# Progress
progress-color=source #8485D9
