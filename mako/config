# Mako notification daemon config - Coastal Slate theme

# Appearance
font=Space Mono 11
width=350
height=100
margin=15
padding=10
border-size=2
border-radius=5
max-visible=5
max-history=20

# Colors (Coastal Slate palette)
background-color=#e3e8e1cc
text-color=#3B3B3B
border-color=#4C98C3

# Urgency levels
[urgency=low]
border-color=#407489

[urgency=normal]
border-color=#4C98C3
progress-color=source #FAC244

[urgency=critical]
border-color=#B76862
text-color=#3B3B3B
progress-color=source #B76862

# Actions
on-notify=none
on-button-left=dismiss
on-button-middle=none
on-button-right=dismiss
on-touch=dismiss

# Timeout
default-timeout=5000
ignore-timeout=1

# Progress
progress-color=source #4C98C3
