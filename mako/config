# Mako notification daemon config

# Appearance
font=Space Mono 11
width=350
height=100
margin=15
padding=10
border-size=2
border-radius=5
max-visible=5
max-history=20

# Colors
background-color=#212529cc
text-color=#f8f9faff
border-color=#ced4daff

# Urgency levels
[urgency=low]
border-color=#003049ff

[urgency=normal]
border-color=#669bbcff
progress-color=source #669bbcff

[urgency=critical]
border-color=#a3b18aff
text-color=#f8f9faff
progress-color=source #c1121fff

# Actions
on-notify=none
on-button-left=dismiss
on-button-middle=none
on-button-right=dismiss
on-touch=dismiss

# Timeout
default-timeout=5000
ignore-timeout=1

# Progress
progress-color=source #669bbcff
